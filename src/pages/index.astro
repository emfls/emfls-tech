---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { problemTypes, devices, categorySlugs, categoryMeta } from '../data/site';
import '../styles/home-search.css';
const guides = (await getCollection('guides')).sort((a,b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()).slice(0, 6);
---
<BaseLayout title="emfls tech — 일상적인 IT 문제 해결" description="PC, Mac, 스마트폰, 인터넷과 주변기기의 문제를 쉽게 진단하고 해결하는 생활 IT 가이드.">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><div class="eyebrow">Everyday tech, made clear</div><h1>무엇이<br /><span style="color:var(--blue)">문제</span>인가요?</h1><p>어려운 IT 용어 대신, 지금 겪고 있는 증상에서 출발합니다. 하나씩 확인하고 가장 짧은 해결 순서를 찾아보세요.</p><div class="search-box" role="search" aria-label="문제 검색 안내"><span>⌕</span><span>예: Wi-Fi가 느리고 자꾸 끊겨요</span><span style="margin-left:auto" class="mono">SEARCH</span></div></div><div class="hero-visual"><img src="/images/tech-diagnostic-hero.png" width="1774" height="887" alt="기기와 네트워크 연결을 점검하는 추상 진단 도식" fetchpriority="high" /><div class="status-card"><div class="status-top"><span><i class="status-dot"></i>SYSTEM STATUS</span><span class="mono">P0 / READY</span></div><h2>문제 해결은<br />순서가 중요합니다.</h2><p>증상 → 환경 → 원인 후보 → 해결 순서. 복잡한 문제를 확인 가능한 작은 단계로 나눕니다.</p></div></div></div></section>
<section class="section" id="problems"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Start with a symptom</div><h2>자주 발생하는 문제</h2></div></div><div class="grid">{problemTypes.map((item)=><a class={`problem-card tone-${item.tone}`} href="#guides"><span class="problem-meta">{item.meta}</span><h3>{item.label}</h3><p>{item.detail}</p></a>)}</div></div></section>
<section class="section" id="devices"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Choose your device</div><h2>기기별 문제 해결</h2></div></div><div class="device-grid">{devices.map((device)=><a class="device-card" href="#guides"><strong>{device}</strong><span class="arrow">↗</span></a>)}</div></div></section>
<section class="section diagnostic" id="diagnostic"><div class="wrap"><div class="eyebrow">Tech Diagnostic / rule-based navigator</div><h2>문제를 진단하는<br />작은 체크리스트</h2><p>기기와 증상을 선택하면 먼저 확인할 항목과 관련 해결 Guide를 안내합니다.</p><a class="diagnose-related" href="/diagnose/">문제 진단 시작 →</a><div class="diagnostic-flow">{['기기 선택','증상 선택','기본 확인','원인 후보','해결 순서'].map((step,i)=><div class="diag-step"><span>0{i+1}</span><h3>{step}</h3></div>)}</div></div></section>
<section class="section" id="guides"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Selected guides</div><h2>최근 / 대표 해결 가이드</h2></div></div><div class="guide-grid">{guides.map((guide)=><a class="guide-card" href={`/guides/${guide.id}`}><span class="tag">{categoryMeta[guide.data.category].name}</span><h3>{guide.data.title}</h3><p>{guide.data.summary}</p><span class="time mono">{guide.data.device} · {guide.data.difficulty}</span></a>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Browse the system</div><h2>전체 카테고리</h2></div></div><nav class="category-list" aria-label="전체 카테고리">{categorySlugs.map((slug)=><a href={`/category/${slug}`}>{categoryMeta[slug].name} <span style="float:right;color:var(--blue)">↗</span></a>)}</nav></div></section>
</BaseLayout>
<script src="../scripts/home-search.ts"></script>
