---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { diagnosticAreas, diagnosticFlows } from '../data/diagnostic';
import '../styles/diagnostic.css';
const guides = await getCollection('guides');
const guideIds = new Set(guides.map((guide) => guide.id));
const outcomes = Object.values(diagnosticFlows).flat();
const invalidGuideSlugs = outcomes.filter((flow) => !guideIds.has(flow.guideSlug));
if (invalidGuideSlugs.length) throw new Error(`Unknown Guide slug(s): ${invalidGuideSlugs.map((flow) => flow.guideSlug).join(', ')}`);
const guideData = Object.fromEntries(guides.map((guide) => [guide.id, { title: guide.data.title, description: guide.data.description, url: `/guides/${guide.id}/` }]));
---
<BaseLayout title="문제 진단 — emfls tech" description="기기와 증상을 선택하고, 먼저 확인할 항목과 추천 해결 Guide를 찾아보세요." path="/diagnose/"><section class="diagnose-page"><div class="wrap diagnose-wrap"><div class="eyebrow">Tech Diagnostic / rule-based navigator</div><h1>문제를 조금씩<br /><span style="color:var(--blue)">좁혀보세요.</span></h1><p class="diagnose-intro">고장 여부를 단정하지 않습니다. 기기와 증상을 고르면 먼저 확인할 항목과 관련 해결 Guide를 안내합니다.</p><div class="wizard" data-wizard><div class="wizard-top"><span class="mono" data-step-label>01 / 04</span><button type="button" class="reset-button" data-reset>처음부터 다시</button></div><div class="step-indicator" aria-label="진단 단계"><span class="active" data-indicator="1">기기</span><span data-indicator="2">증상</span><span data-indicator="3">확인</span><span data-indicator="4">결과</span></div><section data-panel="area"><h2>문제가 있는 기기나 영역을 선택하세요.</h2><div class="diagnostic-options">{diagnosticAreas.map((area)=><button type="button" class="diagnostic-option" data-area={area.id}><strong>{area.label}</strong><span>{area.detail}</span></button>)}</div></section><section data-panel="symptom" hidden><button type="button" class="text-button" data-back="area">← 기기 다시 선택</button><h2>어떤 증상인가요?</h2><div class="diagnostic-options" data-symptoms></div></section><section data-panel="question" hidden><button type="button" class="text-button" data-back="symptom">← 증상 다시 선택</button><h2 data-question></h2><div class="answer-options" data-answers></div></section><section data-panel="result" hidden aria-live="polite"><div class="result-kicker"><span class="status-dot"></span>확인 결과</div><h2>이 문제부터 확인해 보세요.</h2><p class="result-note">아래 내용은 선택한 증상에 따른 기본 안내입니다. 실제 원인은 기기와 환경에 따라 달라질 수 있습니다.</p><div class="outcome"><span class="eyebrow">먼저 확인할 항목</span><p data-first-check></p><span class="eyebrow">가능성이 높은 문제 유형</span><p data-problem-type></p><span class="eyebrow">추천 Guide</span><a class="outcome-guide" data-guide-link><strong data-guide-title></strong><span data-guide-description></span><b>Guide 보기 ↗</b></a></div><a class="diagnose-related" href="/">다른 문제를 더 살펴보기 →</a></section></div></div></section>
<script define:vars={{ flows: diagnosticFlows, guideData }}>
const root = document.querySelector('[data-wizard]');
const panels = { area: root.querySelector('[data-panel="area"]'), symptom: root.querySelector('[data-panel="symptom"]'), question: root.querySelector('[data-panel="question"]'), result: root.querySelector('[data-panel="result"]') };
let selectedFlows = [];
const show = (name) => { Object.entries(panels).forEach(([key, panel]) => panel.hidden = key !== name); const step = name === 'area' ? 1 : name === 'symptom' ? 2 : name === 'question' ? 3 : 4; root.querySelector('[data-step-label]').textContent = `0${step} / 04`; root.querySelectorAll('[data-indicator]').forEach((el) => el.classList.toggle('active', Number(el.dataset.indicator) <= step)); };
root.querySelectorAll('[data-area]').forEach((button) => button.addEventListener('click', () => { selectedFlows = flows[button.dataset.area]; const target = root.querySelector('[data-symptoms]'); target.innerHTML = ''; selectedFlows.forEach((flow) => { const option = document.createElement('button'); option.type = 'button'; option.className = 'diagnostic-option'; option.innerHTML = `<strong>${flow.label}</strong><span>${flow.problemType}</span>`; option.addEventListener('click', () => { root.querySelector('[data-question]').textContent = flow.question; const answers = root.querySelector('[data-answers]'); answers.innerHTML = ''; flow.answers.forEach((answer) => { const choice = document.createElement('button'); choice.type = 'button'; choice.className = 'answer-button'; choice.textContent = answer; choice.addEventListener('click', () => { const guide = guideData[flow.guideSlug]; root.querySelector('[data-first-check]').textContent = flow.firstCheck; root.querySelector('[data-problem-type]').textContent = flow.problemType; root.querySelector('[data-guide-title]').textContent = guide.title; root.querySelector('[data-guide-description]').textContent = guide.description; root.querySelector('[data-guide-link]').href = guide.url; show('result'); }); answers.appendChild(choice); }); show('question'); }); target.appendChild(option); }); show('symptom'); }));
root.querySelectorAll('[data-back]').forEach((button) => button.addEventListener('click', () => show(button.dataset.back)));
root.querySelector('[data-reset]').addEventListener('click', () => show('area'));
</script></BaseLayout>
