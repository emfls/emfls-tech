---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/guides.css';
import { categoryMeta } from '../../data/site';
export async function getStaticPaths(){const guides=await getCollection('guides');return guides.map(guide=>({params:{slug:guide.id},props:{guide}}));}
const {guide}=Astro.props;const {data}=guide;const {Content}=await render(guide);const allGuides=await getCollection('guides');const ids=new Set(allGuides.map(item=>item.id));const invalid=data.relatedGuides.filter(id=>!ids.has(id));if(invalid.length)throw new Error(`${guide.id}: unknown relatedGuide ${invalid.join(', ')}`);
const explicit=data.relatedGuides.flatMap(id=>{const item=allGuides.find(guide=>guide.id===id);return item?[item]:[]});const fallback=allGuides.filter(item=>item.id!==guide.id&&!data.relatedGuides.includes(item.id)&&item.data.category===data.category).sort((a,b)=>a.data.title.localeCompare(b.data.title)||a.id.localeCompare(b.id));const related=[...explicit,...fallback.slice(0,Math.max(0,2-explicit.length))];const canonical=`/guides/${guide.id}/`;const breadcrumbs=[{label:'홈',href:'/'},{label:categoryMeta[data.category].name,href:`/category/${data.category}/`},{label:data.title}];
---
<BaseLayout title={`${data.title} — emfls tech`} description={data.description} path={canonical} type="Article" breadcrumbs={breadcrumbs} jsonLd={{'@context':'https://schema.org','@type':'Article',headline:data.title,description:data.description,url:`https://tech.emfls.com${canonical}`,dateModified:data.updatedDate.toISOString(),publisher:{'@type':'Organization',name:'emfls tech'}}}><article class="guide-page"><div class="wrap guide-wrap"><div class="guide-heading"><div class="eyebrow">{data.device} / {data.problemType}</div><h1>{data.title}</h1><p class="lead">{data.summary}</p><div class="guide-meta"><span class="mono">난이도 {data.difficulty}</span><span class="mono">업데이트 {data.updatedDate.toLocaleDateString('ko-KR')}</span></div></div><div class="guide-columns"><aside class="quick-card"><span class="eyebrow">Quick check</span><h2>먼저 확인할 것</h2><ul>{data.checks.map(check=><li>{check}</li>)}</ul></aside><div class="guide-content"><section class="symptom-block"><h2>증상</h2><ul>{data.symptoms.map(symptom=><li>{symptom}</li>)}</ul></section><Content /><section class="solution-block"><h2>해결 순서</h2>{data.solutions.map((solution,index)=><div class="step"><span class="step-number">{String(index+1).padStart(2,'0')}</span><div><h3>{solution.title}</h3><p>{solution.body}</p></div></div>)}</section>{data.warnings.length>0&&<aside class="warning"><strong>주의</strong><ul>{data.warnings.map(warning=><li>{warning}</li>)}</ul></aside>}<section class="when-done"><h2>해결되지 않을 때</h2><p>같은 증상이 다른 기기에서도 나타나는지 비교하고, 변화가 있었던 설정이나 환경을 되짚어 보세요.</p></section>{related.length>0&&<section><h2>관련 해결 가이드</h2><div class="related-grid">{related.map(item=><a class="guide-card" href={`/guides/${item.id}`}><span class="tag">{categoryMeta[item.data.category].name} · {item.data.device}</span><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></section>}<nav class="guide-next-links" aria-label="추가 탐색"><a href={`/category/${data.category}`}>같은 카테고리 더 보기 →</a><a href="/diagnose/">문제가 정확히 무엇인지 모르겠다면 진단 시작 →</a><a href="/search/">다른 문제 검색 →</a></nav></div></div></div></article></BaseLayout>
