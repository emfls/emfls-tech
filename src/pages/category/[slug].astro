---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categorySlugs, categoryMeta } from '../../data/site';
import '../../styles/guides.css';
export function getStaticPaths(){return categorySlugs.map(slug=>({params:{slug},props:{slug}}));}
const {slug}=Astro.props;const meta=categoryMeta[slug];const guides=(await getCollection('guides')).filter(guide=>guide.data.category===slug);const breadcrumbs=[{label:'홈',href:'/'},{label:meta.name}];
---
<BaseLayout title={`${meta.name} 문제 해결 가이드 — emfls tech`} description={meta.description} path={`/category/${slug}/`} breadcrumbs={breadcrumbs}><section class="category-page"><div class="wrap"><div class="category-heading"><div class="eyebrow">Category / {slug}</div><h1>{meta.name}</h1><p>{meta.description}</p></div><div class="category-columns"><div><h2>대표 문제 유형</h2><div class="problem-pills">{meta.problems.map(problem=><span>{problem}</span>)}</div><h2 class="guide-list-title">이 카테고리의 Guide</h2>{guides.length>0?<div class="guide-list">{guides.map(guide=><a class="guide-card" href={`/guides/${guide.id}/`}><span class="tag">{guide.data.device} · {guide.data.problemType}</span><h3>{guide.data.title}</h3><p>{guide.data.summary}</p><span class="time mono">{guide.data.difficulty} · {guide.data.updatedDate.toLocaleDateString('ko-KR')}</span></a>)}</div>:<div class="empty-category"><p>현재 이 카테고리에 등록된 해결 가이드가 없습니다.</p><div><a href="/search/">전체 문제 검색 →</a><a href="/diagnose/">문제 진단 시작 →</a><a href="/">다른 카테고리 보기 →</a></div></div>}</div><aside class="related-categories"><span class="eyebrow">Related categories</span><h2>함께 살펴보기</h2>{meta.related.map(related=><a href={`/category/${related}/`}>{categoryMeta[related].name} <span>↗</span></a>)}</aside></div></div></section></BaseLayout>
